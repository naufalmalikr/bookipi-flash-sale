{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types src/index.ts",
    "build": "tsc && mkdir -p dist/interfaces/scripts/postgresql/migrations && cp src/interfaces/scripts/postgresql/migrations/001_init.sql dist/interfaces/scripts/postgresql/migrations/001_init.sql",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "node --experimental-strip-types src/interfaces/scripts/postgresql/migrate.ts",
    "seed": "node --experimental-strip-types src/interfaces/scripts/postgresql/seed.ts"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/cors": "11.3.0",
    "zod": "4.6.5",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": "26.10.0"
  }
}
