# Copy to `.env` for local runs: `cp .env.example .env`
#
# TIME RULE (enforced at backend boot): SALE_START / SALE_END MUST be
# UTC ISO-8601 with a trailing `Z` (e.g. 2026-09-23T07:36:23Z). Non-UTC offsets
# (e.g. +02:00) or naive datetimes without `Z` are rejected at boot with a
# 500-at-boot log line plus evidence. All window checks use backend server time.
#
# Generate a fresh window (starts in 60s, ends in 10min):
# GNU/Linux:
#   SALE_START=$(date -u -d '+60 seconds' +%Y-%m-%dT%H:%M:%SZ)
#   SALE_END=$(date -u -d '+10 minutes' +%Y-%m-%dT%H:%M:%SZ)
# macOS/BSD or portable (python3, works everywhere):
#   SALE_START=$(python3 -c "import datetime;print((datetime.datetime.now(datetime.timezone.utc)+datetime.timedelta(seconds=60)).strftime('%Y-%m-%dT%H:%M:%SZ'))")
#   SALE_END=$(python3 -c "import datetime;print((datetime.datetime.now(datetime.timezone.utc)+datetime.timedelta(minutes=10)).strftime('%Y-%m-%dT%H:%M:%SZ'))")
#
# Note: with SALE_START/SALE_END empty the backend defaults to now+60s /
# now+10min, so the sale opens 60s after boot — wait a minute before the
# smoke purchase, or export an already-ACTIVE window (stress README snippet).

SALE_START=
SALE_END=
STOCK_QTY=100
SALE_PRODUCT=Bookipi Flash Widget
# Compose Postgres credentials (compose defaults shown; override in .env).
# POSTGRES_USER is fixed to `postgres` in docker-compose.yml; only these two
# are parameterized there, plus DATABASE_URL below must match them.
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flashsale
# Compose backend reaches Postgres as `postgres:5432` (compose network).
# Host dev (`npm --prefix backend run dev`) needs the host-mapped port instead:
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/flashsale
DATABASE_URL=postgres://postgres:postgres@postgres:5432/flashsale
PORT=3001
RATE_LIMIT_BUY=10
PG_POOL_MAX=50
# Only set to 1 behind a trusted reverse proxy/LB. Default 0: clients cannot
# spoof X-Forwarded-For to rotate the buy rate-limit key.
TRUST_PROXY=0
VITE_API_URL=http://localhost:3001
