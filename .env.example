# Copy to `.env` for local runs: `cp .env.example .env`
#
# TIME RULE (enforced at backend boot): SALE_START / SALE_END MUST be
# UTC ISO-8601 with a trailing `Z` (e.g. 2026-09-23T07:36:23Z). Non-UTC offsets
# (e.g. +02:00) or naive datetimes without `Z` are rejected at boot with a
# 500-at-boot log line plus evidence. All window checks use backend server time.
#
# Generate a fresh window (starts in 60s, ends in 10min):
#   SALE_START=$(date -u -d '+60 seconds' +%Y-%m-%dT%H:%M:%SZ)
#   SALE_END=$(date -u -d '+10 minutes' +%Y-%m-%dT%H:%M:%SZ)

SALE_START=
SALE_END=
STOCK_QTY=100
# Compose backend reaches Postgres as `postgres:5432` (compose network).
# Host dev (`npm --prefix backend run dev`) needs the host-mapped port instead:
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/flashsale
DATABASE_URL=postgres://postgres:postgres@postgres:5432/flashsale
PORT=3001
RATE_LIMIT_BUY=10
PG_POOL_MAX=50
# Only set to 1 behind a trusted reverse proxy/LB. Default 0: clients cannot
# spoof X-Forwarded-For to rotate the buy rate-limit key.
TRUST_PROXY=0
VITE_API_URL=http://localhost:3001
